# DA-LARES Wayfinding — Environment Variables Template
# Copy this file to .env and fill in your real values.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kiosk

PORT=8080

# Set to false on the 24/7 production Server PC to disable /admin, /api/admin/*, and map drawing tools
ENABLE_ADMIN=true
ENABLE_REVIEWER_PORTAL=true

# Admin & Gmail SMTP Configuration (use a Google App Password for SMTP_APP_PASSWORD)
ADMIN_EMAIL=admin@example.com
SMTP_USER=admin@example.com
SMTP_APP_PASSWORD=your_16_char_gmail_app_password
