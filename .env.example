# ==============================================================================
# iGUIDE (DA-CALABARZON Interactive 3D Campus Wayfinding) Environment Template
# Copy to `.env` on each machine (NEVER commit `.env` to Git!)
# ==============================================================================

PORT=8080

# --- MySQL Database (REQUIRED on Production Server PC & Local Dev) ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=kiosk

# --- Super Admin Seed Credentials (First-time setup / recovery) ---
ADMIN_EMAIL=your-super-admin@example.com
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change-this-strong-password

# --- Public Domain & Tunnel Controls ---
# Set PUBLIC_BASE_URL once official domain is live (leaves blank for Cloudflare Quick Tunnel)
PUBLIC_BASE_URL=
# Set NO_TUNNEL=1 on localhost dev if you don't want Cloudflare Tunnel launched automatically
NO_TUNNEL=0

# --- Production Git-Safety Lock ---
# Recommended on the 24/7 Live Server PC:
#   LOCK_STATIC_DISK_EDITORS=1 -> locks disk-writing visual geometry routes (/api/trees, /api/roads,
#   /api/buildings, /api/qares/*, /api/rares/*) so live server updates never conflict with `git pull`.
#   Day-to-day live edits in /login (buildings info, photos, statuses, offices, plots, pins) use MySQL and remain 100% open!
# Set to 0 on your Local Dev laptop when modeling/updating campus geometry.
LOCK_STATIC_DISK_EDITORS=0

# --- Optional Email Notifications (2-Step OTP & Reviewer/Publish Alerts) ---
# Leave SMTP_APP_PASSWORD blank on Local Dev so test sign-ins log OTPs to terminal instead of emailing real users
SMTP_USER=
SMTP_APP_PASSWORD=

# --- Optional Custom MBTiles Locations (defaults to workspace root *.mbtiles) ---
# MBTILES_PATH=
# QARES_MBTILES_PATH=
# RARES_MBTILES_PATH=
